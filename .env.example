# Copy to .env and fill in real values. Never commit .env itself (already
# gitignored). Values below are placeholders, not real secrets.

# --- Server ---
PORT=5001
# Falls back to http://localhost:3000 if unset — but that fallback leaks
# into production if this isn't set there. Used in authController.js's
# verify-email flow.
CLIENT_URL=http://localhost:3000

# --- Database (Neon Postgres) ---
# DATABASE_URL takes priority over everything below whenever it's set
# (see models/index.js) — that's true in every environment here, local
# included, so DB_HOST/DB_NAME/DB_USER/DB_PASS below are effectively dead
# (only read by config/database.js, which nothing requires/imports).
# Kept for now rather than deleted outright; safe to remove in a follow-up.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&channel_binding=require"
# Optional: a separate Neon branch DB, used by config/config.json for
# `npx sequelize-cli db:migrate` (NODE_ENV=development, the default) so
# migrations never accidentally target production.
DATABASE_URL_DEV_BRANCH="postgresql://user:password@host/db?sslmode=require&channel_binding=require"
DB_HOST=localhost
DB_NAME=garden
DB_USER=postgres
DB_PASS=root

# --- Auth ---
JWT_SECRET=
RESET_SECRET=
# Signs email-verification links (POST /api/auth/register ->
# GET /api/auth/verify-email). Deliberately separate from JWT_SECRET so an
# intercepted verification link can't be used as a real login session.
EMAIL_VERIFY_SECRET=
# From the same Google OAuth client designer/services use — verifies the
# id_token in POST /api/auth/google-signin (see socialAuthController.js).
GOOGLE_CLIENT_ID=

# --- Email (Resend) ---
RESEND_API_KEY=
# Used in email templates/links — set to the real deployed URL in production.
BASE_URL=http://localhost:5001
SWALES_APP_URL=http://localhost:3001
DESIGNER_APP_URL=http://localhost:3000

# --- File uploads (Vercel Blob) ---
# Not read explicitly in code — the @vercel/blob SDK's put() picks this up
# from the environment automatically.
BLOB_READ_WRITE_TOKEN=

# --- Unused / dead, found during the 2026-08-23 env hygiene pass ---
# Not referenced anywhere in current code. Leftover from an earlier
# nodemailer-based email flow (nodemailer is still imported in
# utils/emailService.js but never actually called — Resend replaced it).
# Safe to remove from .env once confirmed unneeded; not deleting here
# since that's a code change, not a docs change.
# EMAIL_USER=
# EMAIL_PASS=
# Password_Reset_Url=
# Email_verify_Url=
# AllowedOrigins=   (CORS origins are hardcoded in server.js instead)
